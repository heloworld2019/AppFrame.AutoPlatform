<UserControl x:Class="AppFrame.WpfClient.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AppFrame.WpfClient.Views"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1080">
    <Grid>
        <StackPanel Margin="20" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Vendor.AppName,StringFormat=软件名称：{0}}"
                       Margin="0 5 0 0" />
            <TextBlock Text="{Binding Vendor.VendorName}"
                       Margin="0 5 0 0" />
            <TextBlock Text="{Binding Vendor.OfficeAddress}"
                       Margin="0 5 0 0"/>
            <TextBlock Text="{Binding Vendor.ProductionBase}"
                       Margin="0 5 0 0"/>
            <TextBlock Text="{Binding Vendor.Phone}"
                       Margin="0 5 0 0" />
            <TextBlock Text="{Binding Vendor.WebSite}"
                       Margin="0 5 0 0" />
            <TextBlock Text="{Binding Vendor.SalesPhone}"
                       Margin="0 5 0 0" /> 
          
     

            <TextBlock Text="感谢您使用我们的产品!"
                       Foreground="#00d2ff"
                       Margin="0 10 0 0"/>
            
        

        </StackPanel>
    </Grid>
</UserControl>

<UserControl x:Class="AppFrame.WpfClient.Views.ParameterSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AppFrame.WpfClient.Views"
             xmlns:appui="clr-namespace:AppFrame.AppFrameControls.AppControls;assembly=AppFrame.AppFrameControls"
             xmlns:exten="clr-namespace:AppFrame.WpfClient.Common.Extensions"
             xmlns:cv="clr-namespace:AppFrame.WpfClient.Common.Converters"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1080">
    <UserControl.Resources>
        <Style TargetType="Border" x:Key="BorderStyle">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="0" 
                                              ShadowDepth="1"
                                              Color="#DDDDDD"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <cv:BoolToVisibility x:Key="BoolToVisable"/>
    </UserControl.Resources>
    <Grid>
        <TabControl Background="Transparent"
                    BorderThickness="0 1 0 0"
                    BorderBrush="Orange"
                    Margin="5"
                    SelectedIndex="{Binding ParameterPageIndex}">
            <appui:AppFrameTabItem Header="参数导航">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                     </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <appui:AppFrameButton Type="Customize"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          Width="300"
                                          Height="60"
                                          Background="#404040"
                                          Foreground="White"
                                          BorderThickness="0"
                                          HoverBackground="#454545"
                                          CornerRadius="5"
                                          Margin="5"
                                          Command="{Binding SwitchParameterPageCommand}"
                                          CommandParameter="1">
                        <appui:AppFrameButton.Content>
                            <Grid Width="300"
                                  Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xe636;" 
                                           FontFamily="..\Asset\#iconfont"
                                           VerticalAlignment="Center"
                                           Margin="10 0"
                                           FontSize="30"/>
                                <StackPanel VerticalAlignment="Center"
                                            Margin="5"
                                            Grid.Column="1">
                                    <TextBlock Text="气缸参数"
                                               FontSize="16"/>
                                    <TextBlock Text="配置气缸/真空相关参数"
                                               Margin="0 5 0 0"
                                               Foreground="#BBBBBB"/>
                                </StackPanel>
                                <TextBlock Text=">"
                                           Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontSize="25"
                                           Margin="10 0"/>
                            </Grid>
                        </appui:AppFrameButton.Content>
                    </appui:AppFrameButton>
                    <appui:AppFrameButton Type="Customize"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Bottom"
                                          Width="300"
                                          Height="60"
                                          Background="#404040"
                                          Foreground="White"
                                          BorderThickness="0"
                                          HoverBackground="#454545"
                                          CornerRadius="5"
                                          Grid.Column="1"
                                          Margin="5"
                                          Command="{Binding SwitchParameterPageCommand}"
                                          CommandParameter="2">
                        <appui:AppFrameButton.Content>
                            <Grid Width="300"
                                  Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xe606;" 
                                           FontFamily="..\Asset\#iconfont"
                                           VerticalAlignment="Center"
                                           Margin="10 0"
                                           FontSize="30"/>
                                <StackPanel VerticalAlignment="Center"
                                            Margin="5"
                                            Grid.Column="1">
                                    <TextBlock Text="运动参数"
                                               FontSize="16"/>
                                    <TextBlock Text="配置运动轴相关参数"
                                               Margin="0 5 0 0"
                                               Foreground="#BBBBBB"/>
                                </StackPanel>
                                <TextBlock Text=">"
                                           Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontSize="25"
                                           Margin="10 0"/>
                            </Grid>
                        </appui:AppFrameButton.Content>
                    </appui:AppFrameButton>
                    <appui:AppFrameButton Type="Customize"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Top"
                                          Width="300"
                                          Height="60"
                                          Background="#404040"
                                          Foreground="White"
                                          BorderThickness="0"
                                          HoverBackground="#454545"
                                          CornerRadius="5"
                                          Grid.Row="1"
                                          Margin="5"
                                          Command="{Binding SwitchParameterPageCommand}"
                                          CommandParameter="3">
                        <appui:AppFrameButton.Content>
                            <Grid Width="300"
                                  Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xe63d;" 
                                           FontFamily="..\Asset\#iconfont"
                                           VerticalAlignment="Center"
                                           Margin="10 0"
                                           FontSize="30"/>
                                <StackPanel VerticalAlignment="Center"
                                            Margin="5"
                                            Grid.Column="1">
                                    <TextBlock Text="通讯参数"
                                               FontSize="16"/>
                                    <TextBlock Text="配置设备通讯相关参数"
                                               Margin="0 5 0 0"
                                               Foreground="#BBBBBB"/>
                                </StackPanel>
                                <TextBlock Text=">"
                                           Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontSize="25"
                                           Margin="10 0"/>
                            </Grid>
                        </appui:AppFrameButton.Content>
                    </appui:AppFrameButton>
                    <appui:AppFrameButton Type="Customize"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top"
                                          Width="300"
                                          Height="60"
                                          Background="#404040"
                                          Foreground="White"
                                          BorderThickness="0"
                                          HoverBackground="#454545"
                                          CornerRadius="5"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          Margin="5"
                                          Command="{Binding SwitchParameterPageCommand}"
                                          CommandParameter="4">
                        <appui:AppFrameButton.Content>
                            <Grid Width="300"
                                  Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xe651;" 
                                           FontFamily="..\Asset\#iconfont"
                                           VerticalAlignment="Center"
                                           Margin="10 0"
                                           FontSize="30"/>
                                <StackPanel VerticalAlignment="Center"
                                            Margin="5"
                                            Grid.Column="1">
                                    <TextBlock Text="其他参数"
                                               FontSize="16"/>
                                    <TextBlock Text="配置其他设备参数"
                                               Margin="0 5 0 0"
                                               Foreground="#BBBBBB"/>
                                </StackPanel>
                                <TextBlock Text=">"
                                           Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontSize="25"
                                           Margin="10 0"/>
                            </Grid>
                        </appui:AppFrameButton.Content>
                    </appui:AppFrameButton>
                </Grid>
            </appui:AppFrameTabItem>
            <appui:AppFrameTabItem Header="气缸参数">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Border BorderThickness="0 0 0 1"
                            BorderBrush="#BBBBBB"
                            Grid.Column="1"/>
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal"
                                Margin="5">
                            <TextBlock Text="选择："
                                   VerticalAlignment="Center"/>
                            <ComboBox Width="200"
                                  IsReadOnly="True"/>
                            <TextBlock Text="当前：传送阻挡气缸"
                                   VerticalAlignment="Center"
                                   Margin="20 0"/>
                            <appui:AppFrameButton Content="到动点"
                                                  Type="Normal"
                                                  Height="30"/>
                            <appui:AppFrameButton Content="到原点"
                                                  Type="Normal"
                                                  Margin="10 0"
                                                  Height="30"/>
                            <DockPanel>
                                <Border Width="12"
                                        Height="12"
                                        CornerRadius="6"
                                        Background="Green"
                                        DockPanel.Dock="Top"
                                        />
                                <Border Width="12"
                                        Height="12"
                                        Margin="0 5 0 0"
                                        CornerRadius="6"
                                        Background="Gray"
                                        DockPanel.Dock="Bottom"/>
                            </DockPanel>
                        </StackPanel>
                        <appui:AppFrameButton Content="保存"
                                              Type="Default"
                                              Height="30"
                                              Margin="5"
                                              DockPanel.Dock="Right"/>
                    </DockPanel>
                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding SolenoidParameters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#404040"
                                        Height="60"
                                        CornerRadius="5"
                                        Margin="0 5"
                                        Style="{StaticResource BorderStyle}"
                                        BorderThickness="1"
                                        BorderBrush="Gray">
                                    <DockPanel LastChildFill="False"
                                       VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" 
                                               FontFamily="..\Asset\#iconfont"
                                               VerticalAlignment="Center"
                                               Margin="10 0 10 0"
                                               FontSize="30"/>
                                        <StackPanel Margin="5">
                                            <TextBlock Text="{Binding ParameterName}"
                                                       Foreground="White"/>
                                            <TextBlock Text="{Binding ParameterDescription}"
                                                       Margin="0 5 0 0"
                                                       FontSize="11"
                                                       Foreground="#CCCCCC"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsDouble,Converter={StaticResource BoolToVisable}}"
                                                    DockPanel.Dock="Right"
                                                    Margin="10 0">
                                            <appui:AppFrameTextBox Text="{Binding DoubleValue}"
                                                                   Width="50"
                                                                   Height="35"
                                                                   DockPanel.Dock="Right"
                                                                   Margin="5 0"
                                                                   Watermark="浮点"
                                                                   Background="#CCCCCC"
                                                                   RegexStrings="{x:Static exten:RegexPattenExternsion.NumberPattern}"
                                                                   input:InputMethod.IsInputMethodEnabled="False"/>
                                            <TextBlock Text="秒"
                                                       VerticalAlignment="Center"
                                                       FontSize="16"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsBool,Converter={StaticResource BoolToVisable}}"
                                                    DockPanel.Dock="Right">
                                            <appui:AppFrameToggleButton IsChecked="{Binding BoolValue}"/>
                                            <TextBlock Text="屏蔽"
                                                       Margin="5 0"
                                                       Foreground="Orange"/>
                                        </StackPanel>

                                    </DockPanel>

                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </appui:AppFrameTabItem>
            <appui:AppFrameTabItem Header="运动参数">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Border BorderThickness="0 0 0 1"
                            BorderBrush="#BBBBBB"
                            Grid.Column="1"/>
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal"
                                Margin="5">
                            <TextBlock Text="选择："
                                   VerticalAlignment="Center"/>
                            <ComboBox Width="200"
                                  IsReadOnly="True"/>
                            <TextBlock Text="当前：搬运X轴"
                                   VerticalAlignment="Center"
                                   Margin="20 0"/>
                            <appui:AppFrameButton Content="复位"
                                                  Height="30"
                                                  Width="60"
                                                  Type="Warm"/>
                            <appui:AppFrameButton Content="使能"
                                                  Height="30"
                                                  Width="60"
                                                  Type="Normal"
                                                  Margin="5 0 0 0"/>
                            <appui:AppFrameButton Content="回零"
                                                  Height="30"
                                                  Width="60"
                                                  Type="Normal"
                                                  Margin="5 0 0 0"/>
                            <appui:AppFrameButton Content="急停"
                                                  Height="30"
                                                  Width="60"
                                                  Type="Danger"
                                                  Margin="5 0 0 0"/>
                            <StackPanel Orientation="Horizontal"
                                        Margin="10 0 0 0">
                                <Border Width="12"
                                        Height="12"
                                        CornerRadius="6"
                                        Background="Gray"/>
                                <TextBlock Text="负限"
                                           VerticalAlignment="Center"
                                           Margin="5 0 0 0"/>
                                <Border Width="12"
                                        Height="12"
                                        CornerRadius="6"
                                        Background="Green"
                                        Margin="10 0 0 0"/>
                                <TextBlock Text="原点"
                                           VerticalAlignment="Center"
                                           Margin="5 0 0 0"/>
                                <Border Width="12"
                                        Height="12"
                                        CornerRadius="6"
                                        Background="Gray"
                                        Margin="10 0 0 0"/>
                                <TextBlock Text="正限"
                                           VerticalAlignment="Center"
                                           Margin="5 0 0 0"/>
                                <Border Width="12"
                                        Height="12"
                                        CornerRadius="6"
                                        Background="Orange"
                                        Margin="20 0 0 0"/>
                                <TextBlock Text="轴状态"
                                           VerticalAlignment="Center"
                                           Margin="5 0 0 0"/>
                            </StackPanel>
                        </StackPanel>
                        <appui:AppFrameButton Content="保存"
                                              Type="Default"
                                              Height="30"
                                              Margin="5"
                                              DockPanel.Dock="Right"/>
                    </DockPanel>
                    <StackPanel Grid.Row="1"
                                Margin="0 5">
                        <appui:AppFrameExpander>
                            <appui:AppFrameExpander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xe67d;" 
                                               FontFamily="..\Asset\#iconfont"
                                               VerticalAlignment="Center"
                                               Margin="0 0 10 0"
                                               FontSize="30"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="基础设置"/>
                                        <TextBlock Text="设置轴基础参数，如点动速度，回零速度等等"
                                                           FontSize="11"
                                                           Foreground="#CCCCCC"
                                                           Margin="0 5 0 0"/>
                                    </StackPanel>
                                </Grid>
                                
                            </appui:AppFrameExpander.Header>
                        </appui:AppFrameExpander>
                        <appui:AppFrameExpander 
                                                Margin="0 5 0 0">
                            <appui:AppFrameExpander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xe677;" 
                                               FontFamily="..\Asset\#iconfont"
                                               VerticalAlignment="Center"
                                               Margin="0 0 10 0"
                                               FontSize="30"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="高级设置"/>
                                        <TextBlock Text="设置轴高级参数，如脉冲当量，回零模式等等"
                                                           FontSize="11"
                                                           Foreground="#CCCCCC"
                                                           Margin="0 5 0 0"/>
                                    </StackPanel>
                                </Grid>
                            </appui:AppFrameExpander.Header>
                        </appui:AppFrameExpander>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2"
                                  >
                        <ItemsControl ItemsSource="{Binding AxisPositionParameters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <appui:AppFrameExpander 
                                                            Margin="0 5 0 0">
                                        <appui:AppFrameExpander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xec32;" 
                                                           FontFamily="..\Asset\#iconfont"
                                                           VerticalAlignment="Center"
                                                           Margin="0 0 10 0"
                                                           FontSize="30"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding PositionName}"/>
                                                    <TextBlock Text="调整你想要的轴位置，然后示教保存它"
                                                           FontSize="11"
                                                           Foreground="#CCCCCC"
                                                           Margin="0 5 0 0"/>
                                                </StackPanel>
                                            </Grid>
                                        </appui:AppFrameExpander.Header>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="5"
                                                    VerticalAlignment="Center"
                                                        Grid.Column="1">
                                            <TextBlock Text="{Binding CurrentPosition,StringFormat=当前位置：{0}}"
                                                       VerticalAlignment="Center"/>
                                            <appui:AppFrameButton Content="Jog -"
                                                                  Type="Normal"
                                                                  Margin="40 0 5 0"
                                                                  FontSize="15"/>
                                            <appui:AppFrameButton Content="Jog +"
                                                                  Type="Normal"
                                                                  Margin="5 0"
                                                                  FontSize="15"/>
                                            <appui:AppFrameButton Content="示教"
                                                                  Type="Warm"
                                                                  Margin="5 0"
                                                                  FontSize="15"/>
                                        </StackPanel>
                                    </appui:AppFrameExpander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </appui:AppFrameTabItem>
            <appui:AppFrameTabItem Header="通讯参数"/>
            <appui:AppFrameTabItem Header="配方参数">
                <StackPanel>

                    <TextBlock Text="配方参数" Background="Red"
                               FontSize="30"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />

                </StackPanel>
              

            </appui:AppFrameTabItem>
            <appui:AppFrameTabItem Header="机器人参数">
                <TextBlock Text="我的 机器人参数 "  FontSize="30"/>


            </appui:AppFrameTabItem>
            <appui:AppFrameTabItem Header="Io监视"/>
            <appui:AppFrameTabItem Header="总览信息"/>


            <appui:AppFrameTabItem Header="其他参数"/>
        </TabControl>
    </Grid>
</UserControl>

<UserControl x:Class="AppFrame.WpfClient.Views.IndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AppFrame.WpfClient.Views"
             xmlns:appui="clr-namespace:AppFrame.AppFrameControls.AppControls;assembly=AppFrame.AppFrameControls"
             xmlns:hostGlobal="clr-namespace:AppFrame.AppFrameControls.Common.Global;assembly=AppFrame.AppFrameControls"
             xmlns:exten="clr-namespace:AppFrame.WpfClient.Common.Extensions"
             xmlns:cv="clr-namespace:AppFrame.WpfClient.Common.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="650"
             d:DesignWidth="1080">
    <UserControl.Resources>
        <cv:EnumToColors x:Key="StationStateToColor"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <ItemsControl ItemsSource="{Binding DataBars}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"
                                 />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="5"
                                Margin="5 10 5 10"
                                MinHeight="100"
                                MinWidth="200"
                                >
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="0" 
                                                              ShadowDepth="2"
                                                              Color="#DDDDDD"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Background>
                            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                                <GradientStop Color="{Binding StartBackColor}" Offset="0"/>
                                <GradientStop Color="{Binding EndBackColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="15 0 0 0">
                                <TextBlock Text="{Binding Content}" FontSize="30"/>
                                <TextBlock Text="{Binding Title}" 
                                       FontSize="11"
                                       Margin="0 5 0 0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Text="{Binding Icon}"
                                   FontSize="30"
                                   FontFamily="../Asset/#iconfont"
                                   />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Background="#404040"
                CornerRadius="5"
                Margin="5 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="5">
                        <TextBlock Text="&#xe66b;" 
                                   FontFamily="..\Asset\#iconfont"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="AppFrame设备系统" 
                                   Margin="5 0"
                                   VerticalAlignment="Center"/>
                        <Border Margin="70 0 0 0"
                                Width="12"
                                Height="12"
                                CornerRadius="12"
                                Background="Green"/>
                        <TextBlock Text="待机中" 
                                   Margin="5 0 0 0" />
                    </StackPanel>
                    
                    
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <DockPanel LastChildFill="False">
                            <StackPanel Margin="10 20 0 0"
                                        DockPanel.Dock="Top">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0 5 0 0">
                                    <TextBlock Text="&#xe600;" 
                                               FontFamily="..\Asset\#iconfont"
                                               VerticalAlignment="Center"
                                               FontSize="13"/>
                                    <TextBlock Text="累计生产：43516"
                                               Margin="5 0 0 0"
                                               FontSize="13"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal"
                                            Margin="0 5 0 0">
                                    <TextBlock Text="&#xe8a9;" 
                                               FontFamily="..\Asset\#iconfont"
                                               VerticalAlignment="Center"
                                               FontSize="13"/>
                                    <TextBlock Text="今日运行：6.37 h"
                                               Margin="5 0 0 0"
                                               FontSize="13"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal"
                                            Margin="0 5 0 0">
                                    <TextBlock Text="&#xe8a9;" 
                                               FontFamily="..\Asset\#iconfont"
                                               VerticalAlignment="Center"
                                               FontSize="13"/>
                                    <TextBlock Text="故障时间：0.25 h"
                                               Margin="5 0 0 0"
                                               FontSize="13"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal"
                                            Margin="0 5 0 0">
                                    <TextBlock Text="&#xe601;" 
                                               FontFamily="..\Asset\#iconfont"
                                               VerticalAlignment="Center"
                                               FontSize="13"/>
                                    <TextBlock Text="故障次数：16"
                                               Margin="5 0 0 0"
                                               FontSize="13"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal"
                                        Margin="0 5 0 0">
                                    <TextBlock Text="&#xe611;" 
                                               FontFamily="..\Asset\#iconfont"
                                               VerticalAlignment="Center"
                                               FontSize="13"/>
                                    <TextBlock Text="当前班次：白班"
                                               Margin="5 0 0 0"
                                               FontSize="13"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal"
                                        Margin="0 5 0 0">
                                    <TextBlock Text="&#xe6da;" 
                                               FontFamily="..\Asset\#iconfont"
                                               VerticalAlignment="Center"
                                               FontSize="13"/>
                                    <TextBlock Text="生产型号：J00-521"
                                               Margin="5 0"
                                               FontSize="13"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal"
                                            Margin="0 5 0 0">
                                    <TextBlock Text="&#xe639;" 
                                               FontFamily="..\Asset\#iconfont"
                                               VerticalAlignment="Center"
                                               FontSize="13"/>
                                    <TextBlock Text="生产计划：60000"
                                               Margin="5 0 0 0"
                                               FontSize="13"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal"
                                            Margin="0 5 0 0">
                                    <TextBlock Text="&#xe64b;" 
                                               FontFamily="..\Asset\#iconfont"
                                               VerticalAlignment="Center"
                                               FontSize="13"/>
                                    <TextBlock Text="生产订单：20221211A00021J00521"
                                               Margin="5 0 0 0"
                                               FontSize="13"/>
                                </StackPanel>
                                
                            </StackPanel>
                        </DockPanel>
                        
                        
                        
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel HorizontalAlignment="Center" 
                                        VerticalAlignment="Top"
                                        Margin="0 25 0 0">
                                <Grid >
                                    <Ellipse Width="100"
                                     Height="100"
                                     StrokeThickness="10"
                                     Stroke="Gray">
                                    </Ellipse>
                                    <Ellipse Width="100"
                                     Height="100"
                                     StrokeThickness="10"
                                     StrokeDashArray="11.5,1000"
                                     RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.Stroke>
                                            <LinearGradientBrush  StartPoint="0.5,0.5"
                                                          EndPoint="0,1">
                                                <GradientStop Offset="1"
                                                      Color="#1CEAF9" />
                                                <GradientStop Offset="0"
                                                      Color="#0A96E4" />
                                            </LinearGradientBrush>
                                        </Ellipse.Stroke>
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock Text="47%"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontSize="20"/>
                                </Grid>
                                
                                <StackPanel VerticalAlignment="Center"
                                            Margin="0 10 0 0">
                                    <StackPanel Orientation="Horizontal"
                                            Margin="0 0 0 5">
                                        <Border Width="12"
                                            Height="12"
                                            Background="Gray" />
                                        <TextBlock Text="本月计划：20000"
                                               Margin="10 0 0 0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12"
                                            Height="12"
                                            Background="#0A96E4" />
                                        <TextBlock Text="本月进度：6785"
                                               Margin="10 0 0 0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            
                            <StackPanel HorizontalAlignment="Center" 
                                        VerticalAlignment="Top"
                                        Margin="0 25 0 0"   
                                        Grid.Column="1">
                                <Grid >
                                    <Ellipse Width="100"
                                     Height="100"
                                     StrokeThickness="10"
                                     Stroke="Gray">
                                    </Ellipse>
                                    <Ellipse Width="100"
                                     Height="100"
                                     StrokeThickness="10"
                                     StrokeDashArray="27,1000"
                                     RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.Stroke>
                                            <LinearGradientBrush  StartPoint="0.5,0.5"
                                                          EndPoint="0,1">
                                                <GradientStop Offset="1"
                                                      Color="#4568DC" />
                                                <GradientStop Offset="0"
                                                      Color="#B06AB3" />
                                            </LinearGradientBrush>
                                        </Ellipse.Stroke>
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock Text="98%"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontSize="20"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center"
                                            Margin="0 10 0 0">
                                    <StackPanel Orientation="Horizontal"
                                            Margin="0 0 0 5">
                                        <Border Width="12"
                                            Height="12"
                                            Background="Gray" />
                                        <TextBlock Text="计划良率：100%"
                                               Margin="10 0 0 0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12"
                                            Height="12"
                                            Background="#8469C3" />
                                        <TextBlock Text="实际良率：98%"
                                               Margin="10 0 0 0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                            
                        </Grid>
                    </Grid>
                    
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Margin="10 0 0 15">
                        <TextBlock Text="&#xe66b;" 
                                   FontFamily="..\Asset\#iconfont"
                                   FontSize="20"
                                   VerticalAlignment="Center"/>
                        <TextBlock Margin="10 0 0 0"
                                   DockPanel.Dock="Bottom"
                                   FontSize="25"
                                   Foreground="#F29F4A"
                                   Text="2022-12-11 20:34:15"
                                   Grid.Row="2"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            
            
            
            
            
            
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Border Background="#404040"
                        CornerRadius="5"
                        Margin="5 0"
                        >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="5">
                            <TextBlock Text="&#xe682;" 
                                   FontFamily="..\Asset\#iconfont"
                                   VerticalAlignment="Center"/>
                            <TextBlock Text="系统方案调度" 
                                   Margin="5 0"
                                   VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel 
                                    Margin="10 20 0 0">
                                <TextBlock Text="当前方案：J00-521"
                                       Margin="0"
                                       />
                                <TextBlock Text="描述信息：当前系统的默认方案 J00-521"
                                       Margin="0 5 0 0"
                                       />
                                <TextBlock Text="更新时间：2022-12-06 17:30:21"
                                       Margin="0 10 0 0"
                                       />
                                <TextBlock Text="创建时间：2022-12-06 17:30:21"
                                       Margin="0 5 0 0"
                                       />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="10 10 20 0"
                                        HorizontalAlignment="Right">
                                <appui:AppFrameButton Content="新建方案   >"
                                                      Type="Default"
                                                      Height="25"/>
                                <appui:AppFrameButton Content="切换方案   >"
                                                      Type="Normal"
                                                      Height="25"
                                                      Margin="0 5 0 0"/>
                                <appui:AppFrameButton Content="保存方案   >"
                                                      Type="Normal"
                                                      Height="25"
                                                      Margin="0 5 0 0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border Background="#404040"
                        CornerRadius="5"
                        Margin="5 5 5 0"
                        Grid.Row="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="5">
                            <TextBlock Text="&#xe62e;" 
                                       FontFamily="..\Asset\#iconfont"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="系统控制中心" 
                                   Margin="5 0"
                                   VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1"
                                    Margin="10 20 0 5"
                                    Orientation="Horizontal">
                            <TextBlock Text="系统状态："
                                       FontSize="13"/>
                            <TextBlock Text="待机中"
                                       Foreground="#1F837A"
                                       FontSize="13"/>
                            <TextBlock Text="总线状态："
                                       Margin="20 0 0 0"
                                       FontSize="13"/>
                            <TextBlock Text="正常"
                                       Foreground="#1F837A"
                                       FontSize="13"/>
                            <TextBlock Text="报警状态："
                                       Margin="20 0 0 0"
                                       FontSize="13"/>
                            <TextBlock Text="触发"
                                       Foreground="#FF5722"
                                       FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Margin="10 0 0 5"
                                    >
                            <appui:AppFrameButton FontSize="14"
                                                  Type="Normal"
                                                  Command="{Binding ResetCommand}">
                                <appui:AppFrameButton.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xe695;" 
                                                   FontFamily="..\Asset\#iconfont"/>
                                        <TextBlock Text="复位" 
                                                   Margin="10 0"/>
                                    </StackPanel>
                                </appui:AppFrameButton.Content>
                            </appui:AppFrameButton>
                            <appui:AppFrameButton Type="Default"
                                                  Margin="10 0 0 0"
                                                  FontSize="14">
                                <appui:AppFrameButton.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xe6a4;" 
                                                   FontFamily="..\Asset\#iconfont"/>
                                        <TextBlock Text="启动" 
                                                   Margin="10 0"/>
                                    </StackPanel>
                                </appui:AppFrameButton.Content>
                            </appui:AppFrameButton>
                            <appui:AppFrameButton Type="Danger"
                                                  Margin="10 0 0 0"
                                                  FontSize="14">
                                <appui:AppFrameButton.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xea76;" 
                                                   FontFamily="..\Asset\#iconfont"/>
                                        <TextBlock Text="停止" 
                                                   Margin="10 0"/>
                                    </StackPanel>
                                </appui:AppFrameButton.Content>
                            </appui:AppFrameButton>
                            <appui:AppFrameButton Type="Warm"
                                                  Margin="10 0 0 0"
                                                  FontSize="14">
                                <appui:AppFrameButton.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xe6d1;" 
                                                   FontFamily="..\Asset\#iconfont"/>
                                        <TextBlock Text="清除" 
                                                   Margin="10 0"/>
                                    </StackPanel>
                                </appui:AppFrameButton.Content>
                            </appui:AppFrameButton>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
        
        
        
        
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Visible"
                      >
            <ItemsControl Grid.Row="2"
                      ItemsSource="{Binding StationInfos}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#404040"
                                CornerRadius="5"
                                Margin="5 10 5 5"
                                MaxWidth="200"
                                >
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition />
                                    <RowDefinition Height="50"/>
                                </Grid.RowDefinitions>
                                <DockPanel LastChildFill="False"
                                        Margin="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding StationName}"
                                               VerticalAlignment="Center"/>
                                        <Border Background="{Binding StationState,Converter={StaticResource StationStateToColor}}"
                                            Height="12"
                                            Width="12"
                                            CornerRadius="6"
                                            VerticalAlignment="Center"
                                            Margin="10 0 0 0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                DockPanel.Dock="Right">
                                        <appui:AppFrameButton Type="Warm"
                                                          Content="复位"
                                                          Height="20"
                                                          Width="40"
                                                          />
                                        <appui:AppFrameButton Type="Default"
                                                          Content="操作"
                                                          Height="20"
                                                          Width="40"
                                                          Margin="5 0"/>
                                    </StackPanel>
                                    
                                </DockPanel>
                                <Image Margin="5"
                                       Source="..\Image\device.png" 
                                       Grid.Row="1"
                                       />
                                <StackPanel Grid.Row="2"
                                            Margin="5 0"
                                            VerticalAlignment="Top">
                                    <TextBlock Text="ZYD工作站"
                                           Margin="0 0 0 0"/>
                                    <TextBlock Text="{Binding RuningInfo,StringFormat=设备运行：{0}}"
                                           Margin="0 0 0 0"/>
                                    <TextBlock Text="{Binding AlarmInfo,StringFormat=设备信息：{0}}"
                                           Margin="0 5 0 0"
                                           Foreground="{Binding StationState,Converter={StaticResource StationStateToColor}}"/>
                                     
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
